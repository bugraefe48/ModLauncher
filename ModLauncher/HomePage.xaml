<UserControl x:Class="ModLauncher.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ModLauncher">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">
            <TextBlock Style="{StaticResource PageTitle}" Text="{local:T Home_Title}"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="GreetingText" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="{local:T Home_Subtitle}"/>
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                            Content="{local:T Home_OpenHelp}" Click="Help_Click"/>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{local:T Home_QuickModes}"/>

            <StackPanel x:Name="EmptyPanel">
                <TextBlock Style="{StaticResource Hint}" Text="{local:T Home_NoModes}" Margin="0,0,0,10"/>
                <Button Content="{local:T Home_GoModes}" Click="GoModes_Click" HorizontalAlignment="Left"/>
            </StackPanel>

            <ItemsControl x:Name="ModeCards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="230" Margin="0,0,12,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Fill="{Binding Color}"
                                             Stroke="#66808080" StrokeThickness="1"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                               TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                                    <TextBlock Text="{Binding Actions.Count}" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{local:T Common_Actions}" Style="{StaticResource Hint}"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                                <ui:Button Content="{local:T Home_Run}" Appearance="Primary"
                                           HorizontalAlignment="Stretch" Click="RunCard_Click"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
