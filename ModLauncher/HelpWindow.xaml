<ui:FluentWindow x:Class="ModLauncher.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Help" Height="540" Width="820" MinHeight="420" MinWidth="660"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="HelpTitleBar" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,12,0">
                <ListBox x:Name="TopicList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="TopicList_SelectionChanged"/>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TopicTitle" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TopicBody" TextWrapping="Wrap" LineHeight="22"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
