<UserControl x:Class="ModLauncher.ModesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ModLauncher">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitle}" Text="{local:T Nav_Modes}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL: mod listesi -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TreeView x:Name="ModeTree" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="ModeTree_SelectedItemChanged">
                        <TreeView.Resources>

                            <HierarchicalDataTemplate DataType="{x:Type local:Mode}"
                                                      ItemsSource="{Binding Actions}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FolderIcon" Text="📁" Margin="0,0,6,0"/>
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding Color}" Stroke="#66808080" StrokeThickness="1"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                 Value="True">
                                        <Setter TargetName="FolderIcon" Property="Text" Value="📂"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type local:ModeAction}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ActionIcon" Text="🖥️" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Url">
                                        <Setter TargetName="ActionIcon" Property="Text" Value="🌐"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="CloseApp">
                                        <Setter TargetName="ActionIcon" Property="Text" Value="⛔"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>

                        </TreeView.Resources>
                    </TreeView>

                    <ui:Button Grid.Row="1" Content="{local:T Modes_New}" Appearance="Primary"
                               Click="NewMode_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- SAĞ: düzenleme -->
            <Grid Grid.Column="1">

                <TextBlock x:Name="EmptyText" Text="{local:T Modes_Empty}" Foreground="Gray"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,10,0">

                        <!-- Mod seçilince -->
                        <StackPanel x:Name="ModePanel" Visibility="Collapsed">

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{local:T Modes_General}"/>
                                    <TextBlock Text="{local:T Modes_Name}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             LostFocus="Field_LostFocus"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Actions.Count}" Style="{StaticResource Hint}"/>
                                        <TextBlock Text="{local:T Common_Actions}" Style="{StaticResource Hint}"
                                                   Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="{local:T Modes_Color}" Margin="0,14,0,4"/>
                                    <ListBox x:Name="ColorList" Style="{StaticResource SwatchList}"
                                             SelectedValuePath="Value"
                                             SelectedValue="{Binding Color, Mode=TwoWay}"
                                             SelectionChanged="Color_SelectionChanged"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{local:T Modes_Hotkey}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="HotkeyBox" IsReadOnly="True"
                                                 Text="{Binding Hotkey, Mode=OneWay}"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                        <Button Grid.Column="1" Content="{local:T Modes_Clear}"
                                                Click="ClearHotkey_Click" Margin="8,0,0,0"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="{local:T Modes_HotkeyHint}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{local:T Modes_Actions}"/>
                                    <ui:Button Content="{local:T Modes_Run}" Appearance="Primary"
                                               Click="RunMode_Click" HorizontalAlignment="Stretch"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="{local:T Modes_ActionsHint}"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="{local:T Modes_AddApp}" Click="AddApp_Click" Margin="0,0,8,8"/>
                                        <Button Content="{local:T Modes_AddUrl}" Click="AddUrl_Click" Margin="0,0,8,8"/>
                                        <Button Content="{local:T Modes_AddClose}" Click="AddCloseApp_Click" Margin="0,0,8,8"/>
                                        <Button Content="{local:T Modes_Up}" Click="MoveUp_Click" Margin="0,0,8,8"/>
                                        <Button Content="{local:T Modes_Down}" Click="MoveDown_Click" Margin="0,0,8,8"/>
                                        <Button Content="{local:T Modes_Delete}" Click="DeleteMode_Click" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Eylem seçilince -->
                        <StackPanel x:Name="ActionPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{local:T Action_Title}"/>

                                    <TextBlock x:Name="TargetLabel" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                 LostFocus="Field_LostFocus"/>
                                        <Button x:Name="BrowseTargetButton" Grid.Column="1"
                                                Content="{local:T Action_Browse}"
                                                Click="BrowseTarget_Click" Margin="8,0,0,0"/>
                                    </Grid>

                                    <StackPanel x:Name="ArgsPanel" Margin="0,12,0,0">
                                        <TextBlock Text="{local:T Action_Args}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                                 LostFocus="Field_LostFocus"/>
                                    </StackPanel>

                                    <StackPanel x:Name="BrowserPanel" Margin="0,12,0,0">
                                        <TextBlock Text="{local:T Action_Browser}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding BrowserPath, UpdateSourceTrigger=PropertyChanged}"
                                                     LostFocus="Field_LostFocus"/>
                                            <Button Grid.Column="1" Content="{local:T Action_Browse}"
                                                    Click="BrowseBrowser_Click" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="ForcePanel" Margin="0,12,0,0">
                                        <CheckBox Content="{local:T Action_Force}"
                                                  IsChecked="{Binding ForceClose, Mode=TwoWay}"
                                                  Click="Field_LostFocus"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                   Text="{local:T Action_ForceWarn}"/>
                                    </StackPanel>

                                    <WrapPanel Margin="0,16,0,0">
                                        <Button Content="{local:T Action_Test}" Click="TestAction_Click" Margin="0,0,8,8"/>
                                        <Button Content="{local:T Modes_Up}" Click="MoveUp_Click" Margin="0,0,8,8"/>
                                        <Button Content="{local:T Modes_Down}" Click="MoveDown_Click" Margin="0,0,8,8"/>
                                        <Button Content="{local:T Action_Delete}" Click="DeleteAction_Click" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
